{
    "urls": {
        "auth0": "https://netapp-cloud-account.auth0.com",
        "cloud-manager": "https://api.bluexp.netapp.com",
        "tenancy": "https://api.bluexp.netapp.com",
        "credentials": "https://api.bluexp.netapp.com",
        "workload-factory": "https://api.workloads.netapp.com",
        "wlm-db-redirect-url": "https://cloudmanager.netapp.com",
        "workload-factory-console": "https://console.workloads.netapp.com"
    },
    "kinesis": {
        "stream-name": "audit-service-prod-stream"
    },
    "bucket": {
        "artifacts": "production.artifacts.REGION.workloads.netapp.com",
        "signedTemplates": "production.templates.workloads.netapp.com",
        "region": "us-east-1"
    },
    "ec2": {
        "vcpu-filter": ["4", "8", "16", "32", "64", "72"]
    },
    "db": {
        "tco": {
            "update-recommendation-preference": "7d"
        },
        "assessment": {
            "purge": {
                "interval": "24h"
            }
        },
        "deployments": {
            "purge": {
                "older-than": "30d"
            }
        }
    },
    "reporting": {
        "bucket-name": "prod.reports.data-services.tlveng.netapp.com"
    },
    "clone-age-in-days": 60,
    "well-architected-assessment-notification": "0 5 */7 * *",
    "postpone-age-in-days": 30
}
