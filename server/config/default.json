{
    "app-port": 8085,
    "jwt": {
        "audience": {
            "tenancy": "https://api.cloud.netapp.com"
        }
    },
    "urls": {
        "auth0": "https://staging-netapp-cloud-account.auth0.com",
        "cloud-manager": "https://staging.api.bluexp.netapp.com",
        "local-connector": "http://127.0.0.1:8098",
        "signoz": "http://signoz-otel-collector.signoz.svc.cluster.local:4318/v1/traces",
        "workload-factory": "https://staging.api.workloads.netapp.com",
        "wlm-db-redirect-url": "https://staging.cloudmanager.netapp.com",
        "workload-factory-console": "https://staging.console.workloads.netapp.com"
    },
    "got": {
        "internal": {
            "lookup-timeout": "1s",
            "connect-timeout": "1s",
            "response-timeout": "20s",
            "retry-count": 2
        },
        "external": {
            "lookup-timeout": "2s",
            "connect-timeout": "2s",
            "response-timeout": "50s",
            "retry-count": 2
        },
        "batch": {
            "lookup-timeout": "10s",
            "connect-timeout": "30s",
            "response-timeout": "30s",
            "retry-count": 1
        }
    },
    "log4js": {
        "config-file": "./config/log4js.json",
        "local-config-file": "./config/log4js.local.json"
    },
    "kinesis": {
        "stream-name": "audit-service-staging-stream"
    },
    "service-token": {
        "expiration-margin": "10s"
    },
    "sqs-poll-interval": "30s",
    "jwt-token-expiry": "168h",
    "signed-url-expiry-hours": "168",
    "bucket": {
        "artifacts": "staging-artifacts-REGION-workloads-netapp-com",
        "signedTemplates": "staging-templates-workloads-netapp-com",
        "region": "us-east-1"
    },
    "ec2": {
        "vcpu-filter": ["2", "4", "8", "16", "32", "64", "72"]
    },
    "ssm": {
        "poll-interval": "1s",
        "execution-timeout": "45",
        "connection-poll-interval": "20s"
    },
    "auth": {
        "wlmdb": {
            "timeout": "10s",
            "interval": "500ms"
        },
        "bluexp": {
            "timeout": "10s",
            "interval": "500ms"
        }
    },
    "db": {
        "managed-instance": {
            "update-recommendation-preference": "1d"
        },
        "tco": {
            "update-recommendation-preference": "1d"
        },
        "jobs": {
            "purge": {
                "interval": "24h",
                "older-than": "90d"
            }
        },
        "assessment": {
            "purge": {
                "interval": "4h"
            }
        },
        "deployments": {
            "purge": {
                "older-than": "7d"
            }
        }
    },
    "redis": {
        "endpoint": "127.0.0.1:6379"
    },
    "reporting": {
        "bucket-name": "staging.reports.data-services.tlveng.netapp.com"
    },
    "notification": {
        "sender-email": "calculator@console.workloads.netapp.com",
        "max-emails-per-day": 20
    },
    "clone-age-in-days": 0,
    "well-architected-assessment-notification": "0 * * * *",
    "postpone-age-in-days": 1,
    "aws-sdk": {
        "cache": {
            "ttl": "5m"
        }
    }
}
