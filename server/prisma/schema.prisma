// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model deployment {
  id                        String            @id @default(uuid())
  deployment_id             String            @db.VarChar(255)
  parent_deployment_id      String?           @db.VarChar(255)
  deployment_name           String            @db.VarChar(255)
  account_id                String            @db.VarChar(64)
  cloud_provider_account_id String?           @db.VarChar(80)
  cloud_provider_name       String?           @db.VarChar(30)
  region                    String            @db.VarChar(30)
  credentials_id            String            @db.VarChar(80)
  deployment_status         DEPLOYMENT_STATUS
  deployment_model          DEPLOYMENT_MODEL?
  deployment_status_reason  String?           @db.Text
  start_time                DateTime          @db.DateTime(3)
  end_time                  DateTime?         @db.DateTime(3)
  data                      Json?             @default("{}")
  event                    event[]

  @@unique([account_id, deployment_id], name: "uk_wlmdb_deployment_account_id_deployment_id", map: "uk_wlmdb_deployment_account_id_deployment_id")
  @@index([account_id], map: "k_wlmdb_deployment_account_id")
  @@index([deployment_id], map: "k_wlmdb_deployment_deployment_id")
}

model event {
  id                  String            @id @default(uuid())
  event_id            String            @db.VarChar(255)
  account_id          String            @db.VarChar(64)
  deployment_id       String            @db.VarChar(255)
  deployment_name     String            @db.VarChar(255)
  event_status        DEPLOYMENT_STATUS
  event_status_reason String?           @db.Text
  resource_type       String?           @db.VarChar(255)
  time                DateTime          @db.DateTime(3)
  data                Json?             @default("{}")
  deployment          deployment        @relation(fields: [account_id, deployment_id], references: [account_id, deployment_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wlmdb_event_deployment_id")


  @@unique([deployment_id, event_id], name: "uk_wlmdb_event_deployment_id_event_id", map: "uk_wlmdb_event_deployment_id_event_id")
  @@index([event_id], map: "k_wlmdb_event_event_id")
  @@index([deployment_id], map: "k_wlmdb_event_deployment_id")
  @@index([time], map: "k_wlmdb_event_time")
}

model resource {
  id                        String  @id @default(uuid())
  account_id                String  @db.VarChar(64)
  credentials_id            String  @db.VarChar(80) @default("")
  storage_type              STORAGE_TYPE  @default(FSXN)
  resource_id               String  @db.VarChar(255)
  resource_name             String? @db.VarChar(255)
  resource_type             String  @db.VarChar(20)
  /// co_relation_id is deprecated; will be removed in future releases 
  co_relation_id            String? @db.VarChar(20)
  cloud_provider_account_id String? @db.VarChar(80)
  cloud_provider_name       String? @db.VarChar(30)
  region                    String? @db.VarChar(30)
  metadata                  Json?   @default("{}")
  configurations            Json?   @default("{}")
  assessment_data           Json?   @default("{}")
  assessment_results         Json?   @default("{}")
  database_instances        database_instances[]
  database_instance_config_data database_instance_config_data[]

  @@index([account_id], map: "k_wlmdb_resource_account_id")
  @@index([resource_id], map: "k_wlmdb_resource_resource_id")
  @@unique([account_id, credentials_id, region, resource_id], map: "uk_wlmdb_resource_account_id_credentials_id_region_resource_id")
}

model config {
  id            String   @id @default(uuid())
  account_id    String   @db.VarChar(64)
  name          String   @db.VarChar(255)
  user          String   @db.VarChar(255)
  creation_time DateTime @db.DateTime(3)
  data          Json?    @default("{}")
  modified_time DateTime? @updatedAt @db.DateTime(3)
  database_type DATABASE_TYPE @default(mssql)

  @@index([account_id], map: "k_wlmdb_config_account_id")
  @@unique([account_id, name, user], name: "uk_wlmdb_config_account_id_name_user", map: "uk_wlmdb_config_account_id_name_user")

}

model job {
  id                        String    @id @default(uuid())@db.VarChar(40)
  account_id                String    @db.VarChar(64)
  credentials_id            String    @db.VarChar(80)
  region                    String    @db.VarChar(30)
  type                      JOBTYPE
  status                    JOBSTATUS
  resource_name             String    @db.VarChar(255)
  name                      String    @db.VarChar(255)
  description               String?   @db.VarChar(2048)
  error                     String?   @db.Text
  start_time                DateTime  @db.DateTime(3)
  end_time                  DateTime? @db.DateTime(3)
  parent_job_id             String?   @db.VarChar(40)
  initiator                 String    @db.VarChar(80)@default("SYSTEM")
  last_update_time          DateTime? @updatedAt @db.DateTime(3)
  metadata                  Json?     @default("{}")

  @@index([id], map: "k_wlmdb_job_id")
  @@index([account_id], map: "k_wlmdb_job_account_id")
  @@index([parent_job_id], map: "k_wlmdb_job_parent_job_id")
  @@index([start_time], map: "k_wlmdb_job_start_time")
  @@unique([account_id, name, resource_name, initiator, start_time], name: "uk_wlmdb_config_uniqueJob")
  logs_analysis_reports logs_analysis_reports? @relation(map: "k_wlmdb_job_unique_criteria_logs_analysis_reports")
}

model database_instances {
  id                                String            @id @default(uuid())
  account_id                        String            @db.VarChar(64)
  credentials_id                    String            @db.VarChar(80)
  region                            String            @db.VarChar(30)
  resource_id                       String            @db.VarChar(255)
  database_instance_id              String            @db.VarChar(36)
  database_instance_name            String            @db.VarChar(36)
  fsxn_ids                          String            @db.VarChar(255)
  is_default                        Boolean           @default(value: false)
  database_deployment_type          DATABASE_DEPLOYMENT_TYPE            
  database_type                     String            @db.VarChar(16)
  created_time                      DateTime          @default(now()) @db.DateTime(3)
  updated_time                      DateTime          @default(now()) @updatedAt @db.DateTime(3)
  source                            SOURCE            
  number_of_user_dbs_created        Int?              @default(0)
  sandbox_created                   Boolean?          @default(value: false)
  storage_protocol                  String?           @db.VarChar(30)
  fsx_svm_id                        Json     
  metadata                          Json?             @default("{}")
  configurations                    Json?             @default("{}")
  assessment_results                Json?             @default("{}")
  
  database_instance_config_data                  database_instance_config_data[]

  resource resource @relation(fields: [account_id, credentials_id, region, resource_id], references: [account_id, credentials_id, region, resource_id], onDelete: Cascade, onUpdate: Cascade, map: "k_wlmdb_resource_account_id_credentials_id_region_resource_id")

  @@unique([account_id, credentials_id, resource_id, database_instance_id], name: "uk_wlmdb_database_instances", map: "uk_wlmdb_database_instances")
  @@index([account_id], map: "k_wlmdb_database_instances_account_id")
  @@index([credentials_id], map: "k_wlmdb_database_instances_credentials_id")
  @@index([resource_id], map: "k_wlmdb_database_instances_resource_id")
  @@index([database_instance_name], map: "k_wlmdb_database_instances_database_instance_name")
  logs_analysis_reports logs_analysis_reports[] @relation(map: "k_wlmdb_database_instances_unique_criteria_logs_analysis_reports")
}

model tracked_ec2 {
  id                        String   @id @default(uuid()) @db.VarChar(40)
  instance_id               String   @db.VarChar(30)
  account_id                String   @db.VarChar(64)
  credentials_id            String   @db.VarChar(80)
  region                    String   @db.VarChar(30)
  feature                   String   @db.VarChar(255)
  cloud_provider_account_id String  @db.VarChar(80)
  last_updated              DateTime @default(now())

  @@unique([instance_id, credentials_id, account_id], name: "uk_wlmdb_tracked_ec2", map: "uk_wlmdb_tracked_ec2")
  @@index([instance_id], map: "k_wlmdb_tracked_ec2_instance_id")
  @@index([account_id], name: "k_wlmdb_tracked_ec2_account_id")
}

model database_instance_config_data{
  id                        String   @id @default(uuid()) @db.VarChar(40)
  account_id                String   @db.VarChar(64)
  credentials_id            String   @db.VarChar(80)
  region                    String   @db.VarChar(30)
  resource_id               String   @db.VarChar(255)
  database_instance_id      String   @db.VarChar(36)
  creation_time                 DateTime @default(now())
  last_updated              DateTime @default(now())
  config_data                 Json?    @default("{}")
  config_data_type            String   @db.VarChar(255)@default("CONFIG")
  database_instances database_instances @relation(fields: [account_id, credentials_id, resource_id, database_instance_id], references: [account_id, credentials_id, resource_id, database_instance_id], onDelete: Cascade, onUpdate: Cascade, map: "k_wlmdb_database_instances_unique_criteria")
  resource resource @relation(fields: [account_id, credentials_id, region, resource_id], references: [account_id, credentials_id, region, resource_id], onDelete: Cascade, onUpdate: Cascade, map: "k_wlmdb_database_instance_config_data_resource_unique_criteria")

  @@unique([account_id, credentials_id, region, database_instance_id, creation_time, config_data_type], name: "uk_wlmdb_database_instance_config_data", map: "uk_wlmdb_database_instance_config_data")
  @@index([account_id], name: "k_wlmdb_database_instance_config_data_account_id")
  @@index([credentials_id], map: "k_wlmdb_database_instance_config_data_credentials_id")
  @@index([resource_id], map: "k_wlmdb_database_instance_config_data_resource_id")
}

model onprem_tco_reports {
  id                       String                   @id @default(uuid()) @db.VarChar(40)
  resource_id              String                   @db.VarChar(255)
  account_id               String                   @db.VarChar(64)
  database_type            DATABASE_TYPE            @default(mssql)
  database_deployment_type DATABASE_DEPLOYMENT_TYPE
  host_config              Json?                    @default("{}")
  database_instances_data  Json?                    @default("{}")
  assessment_data          Json?                    @default("{}")
  creation_time            DateTime                 @default(now())
  version                  String                   @db.VarChar(64)

  @@unique([account_id, resource_id, creation_time], name: "uk_wlmdb_onprem_tco_reports", map: "uk_wlmdb_onprem_tco_reports")
  @@index([account_id], name: "k_wlmdb_onprem_tco_reports_account_id")
  @@index([resource_id], map: "k_wlmdb_onprem_tco_reports_resource_id")
  @@index([creation_time], map: "k_wlmdb_onprem_tco_reports_creation_time")
}

model logs_analysis_reports {
  id                   String        @id @default(uuid()) @db.VarChar(40)
  credentials_id       String        @db.VarChar(80)
  resource_id          String        @db.VarChar(255)
  database_instance_id String        @db.VarChar(36)
  job_id              String        @db.VarChar(40)
  account_id           String        @db.VarChar(64)
  database_type        DATABASE_TYPE @default(mssql)
  logs_analysis_data   Json?         @default("{}")
  database_instances   database_instances @relation(fields: [account_id, credentials_id, resource_id, database_instance_id], references: [account_id, credentials_id, resource_id, database_instance_id], onDelete: Cascade, onUpdate: Cascade, map: "k_wlmdb_database_instances_unique_criteria_logs_analysis_reports")
  job                job?          @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "k_wlmdb_job_unique_criteria_logs_analysis_reports")
  creation_time        DateTime      @default(now())
  version              String        @db.VarChar(64)
  start_time           DateTime?     @db.DateTime(3)
  end_time             DateTime?     @db.DateTime(3)

  @@unique([account_id, resource_id, database_instance_id, job_id], name: "uk_wlmdb_logs_analysis_reports", map: "uk_wlmdb_logs_analysis_reports")
  @@unique([job_id], name: "uk_wlmdb_logs_analysis_reports_job_id", map: "uk_wlmdb_logs_analysis_reports_job_id")
  @@index([account_id], name: "k_wlmdb_logs_analysis_reports_account_id")
  @@index([resource_id], map: "k_wlmdb_logs_analysis_reports_resource_id")
  @@index([creation_time], map: "k_wlmdb_logs_analysis_reports_creation_time")
}

enum JOBSTATUS {
  IN_PROGRESS
  COMPLETED
  FAILED
  WARNING
}

enum JOBTYPE {
  DEPLOYMENT
  CREATE_RESOURCE
  PREPARE_RESOURCE
  SANDBOX
  ASSESSMENT
  OPTIMIZATION
  LOGS_ANALYSIS
  WELL_ARCHITECTED
  REGISTER_RESOURCE
}

enum DEPLOYMENT_STATUS {
  CREATE_COMPLETE
  CREATE_IN_PROGRESS
  CREATE_FAILED
  DELETE_COMPLETE
  DELETE_FAILED
  DELETE_IN_PROGRESS
  REVIEW_IN_PROGRESS
  ROLLBACK_COMPLETE
  ROLLBACK_FAILED
  ROLLBACK_IN_PROGRESS
  UPDATE_COMPLETE
  UPDATE_COMPLETE_CLEANUP_IN_PROGRESS
  UPDATE_IN_PROGRESS
  UPDATE_FAILED
  UPDATE_ROLLBACK_COMPLETE
  UPDATE_ROLLBACK_COMPLETE_CLEANUP_IN_PROGRESS
  UPDATE_ROLLBACK_FAILED
  UPDATE_ROLLBACK_IN_PROGRESS
  DELETE_SKIPPED
  IMPORT_COMPLETE
  IMPORT_IN_PROGRESS
  IMPORT_ROLLBACK_COMPLETE
  IMPORT_ROLLBACK_FAILED
  IMPORT_ROLLBACK_IN_PROGRESS
}

enum DEPLOYMENT_MODEL {
  FCI
  Standalone
  HA
}

enum STORAGE_TYPE {
  FSXN
  FSXW
  EBS
}

enum SOURCE {
  deployment
  discovery
}

enum DATABASE_DEPLOYMENT_TYPE {
  Standalone
  FCI
  AOAG
  HA
}

enum DATABASE_TYPE {
  mssql
  pgsql
  oracle
}
