{
    "name": "server",
    "version": "1.1.3",
    "description": "Server App for Workload Manager for DB",
    "type": "module",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "build": "rimraf dist && tsc",
        "start": "node --loader ./dist/src/utils/loader.js dist/src/index.js",
        "dev": "tsx --watch src/index.ts --exclude test/**/*",
        "simulator": "cross-env NODE_ENV=simulator node --loader @esbuild-kit/esm-loader --inspect --watch test/simulator/index.ts",
        "format": "../node_modules/prettier/bin-prettier.js --write \"{src,test}/**/*.ts\"",
        "format:check": "../node_modules/prettier/bin-prettier.js --check \"{src,test}/**/*.ts\"",
        "lint": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\"",
        "lint:fix": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\" --fix",
        "outdated": "npx npm-check-updates",
        "unused": "npx depcheck",
        "build:dev": "npm run build && npm run start",
        "test": "cross-env NODE_ENV=simulator vitest --coverage",
        "test:nowatch": "cross-env NODE_ENV=simulator vitest --run --silent",
        "postinstall": "patch-package",
        "apidoc": "node --import tsx src/utils/generate-documentation.ts && spectral lint documentation.yaml"
    },
    "repository": {
        "type": "git",
        "url": "https://bitbucket.ngage.netapp.com/scm/wlmdb/wlmdb.git"
    },
    "author": "NETAPP",
    "license": "UNLICENSED",
    "dependencies": {
        "@apidevtools/swagger-parser": "^10.1.0",
        "@aws-sdk/client-auto-scaling": "^3.699.0",
        "@aws-sdk/client-bedrock-runtime": "^3.699.0",
        "@aws-sdk/client-cloudformation": "^3.699.0",
        "@aws-sdk/client-cloudwatch": "^3.699.0",
        "@aws-sdk/client-compute-optimizer": "^3.699.0",
        "@aws-sdk/client-cost-explorer": "^3.699.0",
        "@aws-sdk/client-directory-service": "^3.699.0",
        "@aws-sdk/client-ec2": "^3.699.0",
        "@aws-sdk/client-fsx": "^3.699.0",
        "@aws-sdk/client-iam": "^3.699.0",
        "@aws-sdk/client-kms": "^3.699.0",
        "@aws-sdk/client-pricing": "^3.699.0",
        "@aws-sdk/client-resource-groups-tagging-api": "^3.699.0",
        "@aws-sdk/client-s3": "^3.699.0",
        "@aws-sdk/client-secrets-manager": "^3.699.0",
        "@aws-sdk/client-service-quotas": "^3.699.0",
        "@aws-sdk/client-sns": "^3.699.0",
        "@aws-sdk/client-sqs": "^3.699.0",
        "@aws-sdk/client-ssm": "^3.699.0",
        "@aws-sdk/s3-request-presigner": "^3.701.0",
        "@fastify/compress": "^8.0.1",
        "@fastify/cors": "^10.0.1",
        "@fastify/helmet": "^13.0.0",
        "@fastify/sensible": "^6.0.1",
        "@fastify/swagger": "^9.4.0",
        "@fastify/swagger-ui": "^5.2.0",
        "@fastify/type-provider-typebox": "^4.1.0",
        "@opentelemetry/instrumentation-fastify": "^0.42.0",
        "@opentelemetry/instrumentation-http": "^0.55.0",
        "@opentelemetry/sdk-node": "^0.55.0",
        "@prisma/client": "5.17.0",
        "@prisma/instrumentation": "5.17.0",
        "@sinclair/typebox": "^0.33.12",
        "apidoc": "^1.2.0",
        "archiver": "^7.0.1",
        "async": "^3.2.6",
        "aws-sdk-client-mock": "^4.0.2",
        "bluebird": "^3.7.2",
        "bullmq": "^5.30.1",
        "config": "^3.3.12",
        "fastify": "^5.2.0",
        "got": "^14.4.5",
        "handlebars": "^4.7.8",
        "ioredis": "^5.4.1",
        "is-base64": "^1.1.0",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.1.0",
        "lodash-es": "^4.17.21",
        "log4js": "^6.9.1",
        "lru-cache": "^11.0.2",
        "moment": "^2.30.1",
        "nanoid": "^5.0.9",
        "numeral": "^2.0.6",
        "patch-package": "^8.0.0",
        "prisma": "5.17.0",
        "randomatic": "^3.1.1",
