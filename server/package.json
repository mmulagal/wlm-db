{
    "name": "server",
    "version": "1.0.2",
    "description": "Server App for Workload Manager for DB",
    "type": "module",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "build": "rimraf dist && tsc",
        "start": "node --loader ./dist/src/utils/loader.js dist/src/index.js",
        "dev": "node --loader ./dist/src/utils/loader.js --inspect --watch src/index.ts",
        "simulator": "cross-env NODE_ENV=simulator node --loader @esbuild-kit/esm-loader --inspect --watch test/simulator/index.ts",
        "format": "../node_modules/prettier/bin-prettier.js --write \"{src,test}/**/*.ts\"",
        "format:check": "../node_modules/prettier/bin-prettier.js --check \"{src,test}/**/*.ts\"",
        "lint": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\"",
        "lint:fix": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\" --fix",
        "outdated": "npx npm-check-updates",
        "unused": "npx depcheck",
        "build:dev": "npm run build && npm run start",
        "test": "cross-env NODE_ENV=simulator vitest --coverage",
        "test:nowatch": "cross-env NODE_ENV=simulator vitest --run --silent",
        "postinstall": "patch-package",
        "apidoc": "npm run build && node --loader ./dist/src/utils/loader.js dist/src/utils/generate-documentation.js && spectral lint documentation.yaml"
    },
    "repository": {
        "type": "git",
        "url": "https://bitbucket.ngage.netapp.com/scm/wlmdb/wlmdb.git"
    },
    "author": "NETAPP",
    "license": "UNLICENSED",
    "dependencies": {
        "@apidevtools/swagger-parser": "^10.1.0",
        "@aws-sdk/client-bedrock-runtime": "^3.477.0",
        "@aws-sdk/client-cloudformation": "^3.477.0",
        "@aws-sdk/client-cost-explorer": "^3.477.0",
        "@aws-sdk/client-directory-service": "^3.477.0",
        "@aws-sdk/client-ec2": "^3.477.0",
        "@aws-sdk/client-fsx": "^3.477.0",
        "@aws-sdk/client-iam": "^3.477.0",
        "@aws-sdk/client-kms": "^3.477.0",
        "@aws-sdk/client-pricing": "^3.477.0",
        "@aws-sdk/client-resource-groups-tagging-api": "^3.477.0",
        "@aws-sdk/client-s3": "^3.477.0",
        "@aws-sdk/client-secrets-manager": "^3.477.0",
        "@aws-sdk/client-service-quotas": "^3.477.0",
        "@aws-sdk/client-sns": "^3.477.0",
        "@aws-sdk/client-sqs": "^3.427.0",
        "@aws-sdk/client-ssm": "^3.477.0",
        "@aws-sdk/s3-request-presigner": "^3.477.0",
        "@fastify/compress": "^6.5.0",
        "@fastify/cors": "^8.5.0",
        "@fastify/helmet": "^11.1.1",
        "@fastify/sensible": "^5.5.0",
        "@fastify/swagger": "^8.12.1",
        "@fastify/swagger-ui": "^2.0.1",
        "@fastify/type-provider-typebox": "^3.5.0",
        "@opentelemetry/instrumentation-fastify": "^0.32.5",
        "@opentelemetry/instrumentation-http": "^0.46.0",
        "@opentelemetry/sdk-node": "^0.46.0",
        "@prisma/client": "^5.7.1",
        "@prisma/instrumentation": "^5.7.1",
        "@sinclair/typebox": "^0.31.28",
        "async": "^3.2.5",
        "aws-sdk-client-mock": "^3.0.0",
        "bluebird": "^3.7.2",
        "config": "^3.3.9",
        "fastify": "^4.25.1",
        "got": "^12.6.1",
        "handlebars": "^4.7.8",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.1.0",
        "lodash-es": "^4.17.21",
        "log4js": "^6.9.1",
        "lru-cache": "^10.1.0",
        "moment": "^2.29.4",
        "nanoid": "^5.0.4",
        "patch-package": "^8.0.0",
        "prisma": "^5.7.1",
        "randomatic": "^3.1.1",
        "typescript": "^5.3.3",
        "yaml": "^2.3.4"
    },
    "devDependencies": {
        "@aws-sdk/types": "^3.468.0",
        "@esbuild-kit/esm-loader": "^2.6.5",
        "@faker-js/faker": "^8.3.1",
        "@smithy/smithy-client": "^2.1.18",
        "@types/async": "^3.2.24",
        "@types/bluebird": "^3.5.42",
        "@types/config": "^3.3.3",
        "@types/js-sha1": "^0.6.2",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/lodash-es": "^4.17.12",
        "@types/ms": "^0.7.34",
        "@types/node": "^20.10.5",
        "@types/randomatic": "^3.1.5",
        "@types/uuid": "^9.0.7",
        "@vitest/coverage-v8": "^1.1.0",
        "copyfiles": "^2.4.1",
        "cross-env": "^7.0.3",
        "nock": "^13.4.0",
        "prismock": "^1.24.0",
        "rimraf": "^5.0.5",
        "vitest": "^1.1.0"
    }
}
