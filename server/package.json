{
    "name": "server",
    "version": "1.0.0",
    "description": "Server App for Workload Manager for DB",
    "type": "module",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "build": "rimraf dist && tsc",
        "start": "node --loader @esbuild-kit/esm-loader dist/src/index.js",
        "dev": "node --loader @esbuild-kit/esm-loader --inspect --watch src/index.ts",
        "simulator": "cross-env NODE_ENV=simulator node --loader @esbuild-kit/esm-loader --inspect --watch test/simulator/index.ts",
        "lint": "prettier --write .",
        "outdated": "npx npm-check-updates",
        "unused": "npx depcheck",
        "build:dev": "npm run build && npm run start"
    },
    "repository": {
        "type": "git",
        "url": "https://bitbucket.ngage.netapp.com/scm/wlmdb/wlmdb.git"
    },
    "author": "NETAPP",
    "license": "UNLICENSED",
    "dependencies": {
        "@esbuild-kit/esm-loader": "^2.5.5",
        "@fastify/compress": "^6.4.0",
        "@fastify/cors": "^8.3.0",
        "@fastify/helmet": "^11.0.0",
        "@fastify/sensible": "^5.2.0",
        "@fastify/swagger": "^8.8.0",
        "@fastify/swagger-ui": "^1.9.2",
        "@opentelemetry/instrumentation-fastify": "^0.32.0",
        "@opentelemetry/instrumentation-http": "^0.41.0",
        "@opentelemetry/sdk-node": "^0.41.0",
        "@sinclair/typebox": "^0.29.4",
        "async": "^3.2.4",
        "config": "^3.3.9",
        "fastify": "^4.19.2",
        "got": "^12.6.0",
        "jsonwebtoken": "^9.0.1",
        "jwks-rsa": "^3.0.1",
        "lodash-es": "^4.17.21",
        "log4js": "^6.9.1",
        "nanoid": "^4.0.2",
        "randomatic": "^3.1.1"
    },
    "devDependencies": {
        "@aws-sdk/client-ec2": "^3.371.0",
        "@aws-sdk/types": "^3.337.0",
        "@types/async": "^3.2.20",
        "@types/config": "^3.3.0",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/lodash-es": "^4.17.7",
        "@types/ms": "^0.7.31",
        "@types/node": "^20.2.3",
        "@types/randomatic": "^3.1.3",
        "@types/uuid": "^9.0.1",
        "aws-sdk-client-mock": "^2.1.1",
        "cross-env": "^7.0.3",
        "nock": "^13.3.1",
        "prettier": "2.8.8",
        "rimraf": "^4.4.1",
        "typescript": "^5.0.4"
    }
}
