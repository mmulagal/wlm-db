{
    "name": "server",
    "version": "3.0.0",
    "description": "Server App for Workload Manager for DB",
    "type": "module",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "build": "rimraf dist && tsc && copyfiles -u 0 \"src/**/*.json\" dist",
        "start": "cross-env NODE_ENV=local_dev node --loader ./dist/src/utils/loader.js dist/src/index.js",
        "dev": "cross-env NODE_ENV=local_dev tsx --watch src/index.ts --exclude test/**/*",
        "simulator": "cross-env NODE_ENV=simulator tsx --watch test/simulator/index.ts",
        "format": "../node_modules/prettier/bin-prettier.js --write \"{src,test}/**/*.ts\"",
        "format:check": "../node_modules/prettier/bin-prettier.js --check \"{src,test}/**/*.ts\"",
        "lint": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\"",
        "lint:fix": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\" --fix",
        "outdated": "npx npm-check-updates",
        "unused": "npx depcheck",
        "build:dev": "npm run build && npm run start",
        "test": "cross-env NODE_ENV=simulator vitest --coverage",
        "test:nowatch": "cross-env NODE_ENV=simulator vitest --run --silent --no-coverage",
        "postinstall": "patch-package",
        "apidoc": "node --import tsx src/utils/generate-documentation.ts && spectral lint documentation.yaml"
    },
    "repository": {
        "type": "git",
        "url": "https://bitbucket.ngage.netapp.com/scm/wlmdb/wlmdb.git"
    },
    "author": "NETAPP",
    "license": "UNLICENSED",
    "dependencies": {
        "@apidevtools/swagger-parser": "^12.1.0",
        "@aws-sdk/client-auto-scaling": "^3.988.0",
        "@aws-sdk/client-backup": "^3.988.0",
        "@aws-sdk/client-bedrock": "^3.988.0",
        "@aws-sdk/client-bedrock-runtime": "^3.988.0",
        "@aws-sdk/client-cloudformation": "^3.988.0",
        "@aws-sdk/client-cloudwatch": "^3.988.0",
        "@aws-sdk/client-cloudwatch-logs": "^3.988.0",
        "@aws-sdk/client-compute-optimizer": "^3.988.0",
        "@aws-sdk/client-cost-explorer": "^3.988.0",
        "@aws-sdk/client-directory-service": "^3.988.0",
        "@aws-sdk/client-ec2": "^3.988.0",
        "@aws-sdk/client-fsx": "^3.988.0",
        "@aws-sdk/client-iam": "^3.988.0",
        "@aws-sdk/client-kms": "^3.988.0",
        "@aws-sdk/client-pricing": "^3.988.0",
        "@aws-sdk/client-resource-groups-tagging-api": "^3.988.0",
        "@aws-sdk/client-s3": "^3.988.0",
        "@aws-sdk/client-secrets-manager": "^3.988.0",
        "@aws-sdk/client-service-quotas": "^3.988.0",
        "@aws-sdk/client-sesv2": "^3.988.0",
        "@aws-sdk/client-sns": "^3.988.0",
        "@aws-sdk/client-sqs": "^3.988.0",
        "@aws-sdk/client-ssm": "^3.988.0",
        "@aws-sdk/s3-request-presigner": "^3.988.0",
        "@fastify/compress": "^8.3.1",
