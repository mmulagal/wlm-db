FROM node:lts-alpine3.21

WORKDIR /opt/netapp/wlmdb

ARG APP_USER=netappuser
ARG APP_GROUP=netappgroup

ADD src ./src
ADD test ./test
ADD config ./config
ADD resources/mssql/templates ./resources/mssql/templates
ADD resources/mssql/terraform ./resources/mssql/terraform
ADD resources/pgsql/templates ./resources/pgsql/templates/
ADD resources/pgsql/terraform ./resources/pgsql/terraform
COPY package.json ./
COPY package-lock.json ./

COPY __mocks__ ./__mocks__
COPY prisma ./prisma/
COPY patches ./patches/

# Change the permissions of the /resources/mssql directory to give read and write access
RUN chmod -R 766 ./resources/mssql
RUN chmod -R 766 ./resources/pgsql

RUN npm i

# prisma generate command after every change to Prisma schema to update the generated Prisma Client code.
RUN npx prisma generate

# build mode - development or production
ARG ARG_WLMDB_BUILD_MODE

# Team City build number
ARG ARG_WLMDB_BUILD_TC

# GIT short hash
ARG ARG_WLMDB_BUILD_GIT

# persist arguments as environment variables
ENV ENV_WLMDB_BUILD_GIT $ARG_WLMDB_BUILD_GIT
ENV ENV_WLMDB_BUILD_TC $ARG_WLMDB_BUILD_TC
ENV ENV_WLMDB_BUILD_MODE $ARG_WLMDB_BUILD_MODE
ENV NODE_CONFIG_ENV $ARG_WLMDB_BUILD_MODE
ENV NODE_ENV $ARG_WLMDB_BUILD_MODE

#Create a non-root group and user, and give them ownership of the app files.
RUN addgroup -S ${APP_GROUP} && adduser -S -G ${APP_GROUP} -u 1001 ${APP_USER}



RUN chown -R netappuser:netappgroup /opt/netapp/wlmdb
RUN chmod 777 /log
RUN chown -R netappuser:netappgroup /log
# Switch to the non-root user.
USER ${APP_USER}

EXPOSE 8085

CMD ["node", "--loader","@esbuild-kit/esm-loader", "test/simulator/index.ts"]
