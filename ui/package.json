{
    "name": "ui",
    "version": "2.0.4",
    "homepage": "",
    "private": true,
    "type": "module",
    "dependencies": {
        "@emotion/css": "^11.11.2",
        "@netapp/design-system": "file:netapp-design-system-1.5.40.tgz",
        "@netapp/icons": "file:netapp-icons-1.0.8.tgz",
        "@reduxjs/toolkit": "2.9.0",
        "@tlveng/wlm-ds": "^1.0.60",
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/rollup": "^8.1.0",
        "@vitejs/plugin-react-swc": "^4.1.0",
        "classnames": "^2.5.1",
        "dom-to-image": "^2.6.0",
        "exceljs": "^4.4.0",
        "fflate": "^0.8.2",
        "i18next": "25.5.3",
        "i18next-http-backend": "3.0.2",
        "jspdf": "^3.0.3",
        "jszip": "^3.10.1",
        "lodash": "^4.17.14",
        "moment": "^2.30.1",
        "numeral": "^2.0.6",
        "p-limit": "^7.1.1",
        "pdf-lib": "^1.17.1",
        "query-string": "^9.3.1",
        "react": "^19.2.0",
        "react-collapse": "^5.1.1",
        "react-dom": "^19.2.0",
        "react-fullstory": "^1.4.0",
        "react-i18next": "^16.0.0",
        "react-measure": "^2.5.2",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.9.3",
        "react-syntax-highlighter": "^15.6.6",
        "redux-mock-store": "^1.5.5",
        "sanitize-html": "^2.17.0",
        "style-inject": "^0.3.0",
        "uuid": "^13.0.0",
        "vite": "^7.1.9",
        "vite-tsconfig-paths": "^5.1.4",
        "web-vitals": "^5.1.0"
    },
    "scripts": {
        "start": "cross-env HOST=localhost PORT=4300 VITE_APP_USE_CM_FORWARDER=false vite",
        "simulator": "dotenv cross-env -e .env.simulator HOST=localhost PORT=4300 vite",
        "local": "dotenv cross-env -e .env.local HOST=localhost PORT=4300 vite",
        "proxy-staging": "cross-env HOST=localhost PORT=4300 VITE_APP_API_URL=https://staging.api.workloads.netapp.com vite",
        "proxy-production": "dotenv cross-env -e .env.production HOST=localhost PORT=4300 vite",
        "build:local": "dotenv -e .env.development vite build",
        "build:staging": "dotenv -e .env.staging vite build  && dotenv -e .env.staging -- ejs workload-config.json -o build/workload-config.json && ejs workload-policies.json -o build/workload-policies.json",
        "build:preprod": "dotenv -e .env.production vite build && dotenv -e .env.production -- ejs workload-config.json -o build/workload-config.json && ejs workload-policies.json -o build/workload-policies.json",
        "build:production": "dotenv -e .env.production vite build && dotenv -e .env.production -- ejs workload-config.json -o build/workload-config.json && ejs workload-policies.json -o build/workload-policies.json",
        "test": "vitest run",
        "test-dev": "vitest watch",
        "format": "../node_modules/prettier/bin-prettier.js --write \"src/**/*.{js,jsx,ts,tsx,css,scss,md,json}\"",
        "format:check": "../node_modules/prettier/bin-prettier.js --check \"src/**/*.{js,jsx,ts,tsx,css,scss,md,json}\"",
        "lint": "../node_modules/eslint/bin/eslint.js \"src/**/*.{js,jsx,ts,tsx}\"",
        "lint:fix": "../node_modules/eslint/bin/eslint.js \"src/**/*.{js,jsx,ts,tsx}\" --fix"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/rollup": "^8.1.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/jest": "^29.5.5",
        "@types/lodash": "^4.17.13",
        "@types/node": "^24.0.10",
        "@types/numeral": "^2.0.5",
        "@types/react": "^19.1.8",
        "@types/react-collapse": "^5.0.1",
        "@types/react-dom": "^19.1.3",
        "@types/react-measure": "^2.0.12",
        "@types/redux-mock-store": "^1.0.3",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^3.1.2",
        "cross-env": "^10.0.0",
        "dotenv-cli": "^7.4.4",
        "ejs": "^3.1.10",
        "jest-teamcity-reporter": "^0.9.0",
        "jsdom": "^25.0.1",
        "sass": "^1.89.2",
        "typescript": "^5.7.3",
        "vite-plugin-version-mark": "^0.1.4",
        "vitest": "^3.1.2"
    },
    "jest": {
        "transformIgnorePatterns": []
    }
}
