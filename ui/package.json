{
    "name": "ui",
    "version": "0.1.0",
    "homepage": "./",
    "private": true,
    "dependencies": {
        "@netapp/design-system": "0.4.31",
        "@netapp/icons": "^1.0.8",
        "@reduxjs/toolkit": "1.9.6",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^13.5.0",
        "@types/jest": "^29.5.5",
        "@types/node": "^20.8.2",
        "@types/react": "^18.2.24",
        "@types/react-dom": "^18.2.8",
        "auth0-js": "^9.22.1",
        "axios": "^1.5.1",
        "lodash": "^4.17.21",
        "moment": "^2.29.4",
        "numeral": "^2.0.6",
        "query-string": "^8.1.0",
        "react": "^18.2.0",
        "react-copy-to-clipboard": "^5.0.4",
        "react-dom": "^18.2.0",
        "react-fullstory": "^1.4.0",
        "react-highlight-words": "^0.20.0",
        "react-popover": "^0.5.10",
        "react-redux": "^8.1.3",
        "react-router-dom": "^6.16.0",
        "react-scripts": "5.0.1",
        "redux-mock-store": "^1.5.4",
        "sanitize-html": "^2.11.0",
        "typescript": "5.2.2",
        "web-vitals": "^3.5.0"
    },
    "scripts": {
        "start": "cross-env HOST=localhost PORT=4300 REACT_APP_USE_CM_FORWARDER=false react-scripts start",
        "build:local": "dotenv -e .env.development react-scripts build",
        "build:staging": "dotenv -e .env.staging react-scripts build && cpy workload-policies.json workload-config-stage.json build/ && mv build/workload-config-stage.json build/workload-config.json",
        "build:preprod": "dotenv -e .env.preprod react-scripts build && cpy workload-policies.json workload-config-preprod.json build/ && mv build/workload-config-preprod.json build/workload-config.json",
        "build:production": "dotenv -e .env.production react-scripts build && cpy workload-policies.json workload-config-production.json build/ && mv build/workload-config-production.json build/workload-config.json",
        "test": "react-scripts test --coverage",
        "eject": "react-scripts eject"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^5.13.0",
        "@testing-library/react": "^14.0.0",
        "@testing-library/user-event": "^13.1.9",
        "@types/numeral": "^2.0.2",
        "@types/redux-mock-store": "^1.0.3",
        "cpy-cli": "^5.0.0",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^4.0.0",
        "jest-teamcity-reporter": "^0.9.0",
        "react-scripts": "5.0.1",
        "sass": "^1.66.0"
    },
    "jest": {
        "transformIgnorePatterns": []
    }
}
