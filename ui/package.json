{
    "name": "ui",
    "version": "1.1.3",
    "homepage": "",
    "private": true,
    "type": "module",
    "dependencies": {
        "@netapp/design-system": "1.5.14",
        "@netapp/icons": "^1.0.8",
        "@reduxjs/toolkit": "2.4.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/rollup": "^8.1.0",
        "@vitejs/plugin-react-swc": "^3.7.1",
        "auth0-js": "^9.24.1",
        "axios": "^1.7.4",
        "eslint-config-react-app": "^7.0.1",
        "jszip": "^3.10.1",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "numeral": "^2.0.6",
        "query-string": "^9.0.0",
        "react": "^18.2.0",
        "react-copy-to-clipboard": "^5.0.4",
        "react-dom": "^18.2.0",
        "react-fullstory": "^1.4.0",
        "react-highlight-words": "^0.20.0",
        "react-popover": "^0.5.10",
        "react-redux": "^9.0.3",
        "react-router-dom": "^7.0.1",
        "react-syntax-highlighter": "^15.5.0",
        "redux-mock-store": "^1.5.4",
        "sanitize-html": "^2.12.1",
        "style-inject": "^0.3.0",
        "vite": "^5.4.11",
        "vite-plugin-css-injected-by-js": "^3.5.1",
        "vite-plugin-eslint": "^1.8.1",
        "vite-plugin-svgr": "^4.3.0",
        "vite-tsconfig-paths": "^5.1.3",
        "web-vitals": "^4.0.1"
    },
    "scripts": {
        "start": "cross-env HOST=localhost PORT=4300 VITE_APP_USE_CM_FORWARDER=false vite",
        "simulator": "dotenv cross-env -e .env.simulator HOST=localhost PORT=4300 vite",
        "local": "dotenv cross-env -e .env.local HOST=localhost PORT=4300 vite",
        "proxy-staging": "cross-env HOST=localhost PORT=4300 VITE_APP_API_URL=https://staging.api.workloads.netapp.com vite",
        "proxy-production": "dotenv cross-env -e .env.production HOST=localhost PORT=4300 vite",
        "build:local": "dotenv -e .env.development vite build",
        "build:staging": "dotenv -e .env.staging vite build  && dotenv -e .env.staging -- ejs workload-config.json -o build/workload-config.json && ejs workload-policies.json -o build/workload-policies.json",
        "build:preprod": "dotenv -e .env.production vite build && dotenv -e .env.production -- ejs workload-config.json -o build/workload-config.json && ejs workload-policies.json -o build/workload-policies.json",
        "build:production": "dotenv -e .env.production vite build && dotenv -e .env.production -- ejs workload-config.json -o build/workload-config.json && ejs workload-policies.json -o build/workload-policies.json",
        "test": "vitest run",
        "test-dev": "vitest watch"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/rollup": "^8.1.0",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^13.5.0",
        "@types/lodash": "^4.17.13",
        "@types/jest": "^29.5.5",
        "@types/node": "^20.8.2",
        "@types/numeral": "^2.0.2",
        "@types/react": "^18.2.65",
        "@types/react-dom": "^18.2.8",
        "@types/redux-mock-store": "^1.0.3",
        "@typescript-eslint/eslint-plugin": "^8.13.0",
        "@typescript-eslint/parser": "^8.13.0",
        "@vitest/coverage-v8": "^2.1.5",
        "cross-env": "^7.0.3",
        "dotenv-cli": "^4.0.0",
        "ejs": "^3.1.9",
        "jest-teamcity-reporter": "^0.9.0",
        "jsdom": "^25.0.1",
        "sass": "^1.66.0",
        "typescript": "^5.7.2",
        "vite-plugin-version-mark": "^0.1.2",
        "vitest": "^2.1.5"
    },
    "jest": {
        "transformIgnorePatterns": []
    }
}
