{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Remove Images Older Than 10 days",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["$MODE-"],
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 10
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 2,
      "description": "Leave at least 10 images",
      "selection": {
        "tagStatus": "any",
        "countType": "imageCountMoreThan",
        "countNumber": 10
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}