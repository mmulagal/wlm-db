{
  "author": "",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.821.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.821.0",
    "@types/node": "^22.15.29",
    "copyfiles": "^2.4.1",
    "execa": "^9.6.0",
    "express": "^5.1.0",
    "is-base64": "^1.1.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "log4js": "^6.9.1",
    "numeral": "^2.0.6",
    "pretty-ms": "^9.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "yargs": "^18.0.0",
    "zod": "^3.25.49"
  },
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/is-base64": "^1.1.3",
    "@types/lodash-es": "^4.17.12",
    "@types/ms": "^2.1.0",
    "@types/yargs": "^17.0.33",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.0"
  },
  "license": "ISC",
  "main": "dist/src/agent.js",
  "name": "logs-analyzer",
  "pkg": {
    "assets": [
      "dist/**/*",
      "node_modules/**/*",
      "src/**/*.json",
      "src/**/*.js",
      "src/**/*.ts"
    ],
    "scripts": [
      "dist/src/agent.js",
      "dist/bundle.js"
    ]
  },
  "scripts": {
    "bundle": "esbuild src/agent.ts --bundle --platform=node --outfile=dist/agent.js --external:config.extends --external:path9",
    "pkg:win": "npm run bundle && npx pkg dist/agent.js --targets node22-win-x64 --output dist/agent-win",
    "pkg:mac": "npm run bundle && npx pkg dist/agent.js --targets node22-macos-x64 --output dist/agent-macos",
    "pkg:linux": "npm run bundle && npx pkg dist/agent.js --targets node22-linux-x64 --output dist/agent-linux",
    "pkg:all": "npm run pkg:win && npm run pkg:mac && npm run pkg:linux",
    "build": "rimraf dist && tsc && copyfiles -u 0 \"src/**/*.json\" dist",
    "start": "tsc && node dist/app.js",
    "test": "vitest --run",
    "format": "../node_modules/prettier/bin-prettier.js --write \"{src,test}/**/*.ts\"",
    "format:check": "../node_modules/prettier/bin-prettier.js --check \"{src,test}/**/*.ts\"",
    "lint": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\"",
    "lint:fix": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\" --fix"
  },
  "type": "module",
  "version": "1.0.0"
}
