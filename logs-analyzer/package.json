{
  "author": "",
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.751.0",
    "@aws-sdk/client-bedrock-runtime": "^3.751.0",
    "@aws-sdk/client-cloudformation": "^3.774.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.804.0",
    "@aws-sdk/client-ssm": "^3.759.0",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@types/node": "^22.14.0",
    "copyfiles": "^2.4.1",
    "execa": "^9.5.2",
    "express": "^4.17.1",
    "is-base64": "^1.1.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "log4js": "^6.9.1",
    "ms": "^2.1.3",
    "numeral": "^2.0.6",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.3",
    "yargs": "^17.7.2",
    "zod": "^3.24.2"
  },
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/express": "^4.17.1",
    "@types/is-base64": "^1.1.3",
    "@types/lodash": "^4.17.16",
    "@types/lodash-es": "^4.17.12",
    "@types/ms": "^2.1.0",
    "@types/yargs": "^17.0.33",
    "esbuild": "^0.25.2",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.1.1"
  },
  "license": "ISC",
  "main": "dist/src/agent.js",
  "name": "agentic-systen",
  "pkg": {
    "assets": [
      "dist/**/*",
      "node_modules/**/*",
      "src/**/*.json",
      "src/**/*.js",
      "src/**/*.ts"
    ],
    "scripts": [
      "dist/src/agent.js",
      "dist/bundle.js"
    ]
  },
  "scripts": {
    "bundle": "esbuild src/agent.ts --bundle --platform=node --outfile=dist/agent.js --external:config.extends --external:path9",
    "pkg:win": "npm run bundle && npx pkg dist/agent.js --targets node20-win-x64 --output dist/agent-win",
    "pkg:mac": "npm run bundle && npx pkg dist/agent.js --targets node20-macos-x64 --output dist/agent-macos",
    "pkg:linux": "npm run bundle && npx pkg dist/agent.js --targets node20-linux-x64 --output dist/agent-linux",
    "pkg:all": "npm run pkg:win && npm run pkg:mac && npm run pkg:linux",
    "build": "rimraf dist && tsc && copyfiles -u 0 \"src/**/*.json\" dist",
    "lint": "eslint . --ext .ts",
    "start": "tsc && node dist/app.js",
    "test": "vitest --run"
  },
  "type": "module",
  "version": "1.0.0"
}
