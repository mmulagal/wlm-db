{
    "author": "",
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.958.0",
        "@aws-sdk/client-cloudwatch-logs": "^3.958.0",
        "@types/node": "^25.0.3",
        "commander": "^14.0.2",
        "execa": "^9.6.1",
        "express": "^5.2.1",
        "is-base64": "^1.1.0",
        "lodash": "^4.17.21",
        "lodash-es": "^4.17.22",
        "log4js": "^6.9.1",
        "numeral": "^2.0.6",
        "rimraf": "^6.1.2",
        "tsx": "^4.21.0"
    },
    "description": "",
    "devDependencies": {
        "@eslint/js": "^9.31.0",
        "@types/is-base64": "^1.1.3",
        "@types/lodash-es": "^4.17.12",
        "@types/ms": "^2.1.0",
        "@types/yargs": "^17.0.33",
        "@yao-pkg/pkg": "^6.6.0",
        "cpx": "^1.5.0",
        "esbuild": "^0.27.2",
        "eslint": "^9.31.0",
        "globals": "^16.3.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.37.0",
        "vitest": "^3.2.4"
    },
    "license": "ISC",
    "main": "dist/src/agent.js",
    "name": "logs-analyzer",
    "pkg": {
        "assets": [
            "dist/**/*",
            "node_modules/**/*",
            "src/**/*.json",
            "src/**/*.js",
            "src/**/*.ts"
        ],
        "scripts": [
            "dist/src/agent.js",
            "dist/bundle.js"
        ]
    },
    "scripts": {
        "bundle": "esbuild src/agent.ts --bundle --platform=node --outfile=dist/agent.js --external:config.extends --external:path9",
        "pkg:win": "npm run bundle && npx pkg dist/agent.js --targets node20-win-x64 --output dist/agent-win",
        "pkg:mac": "npm run bundle && npx pkg dist/agent.js --targets node20-macos-x64 --output dist/agent-macos",
        "pkg:linux": "npm run bundle && npx pkg dist/agent.js --targets node20-linux-x64 --output dist/agent-linux",
        "pkg:all": "npm run pkg:win && npm run pkg:mac && npm run pkg:linux",
        "build": "rimraf dist && tsc",
        "start": "tsc && node dist/app.js",
        "test": "vitest --run",
        "format": "../node_modules/prettier/bin-prettier.js --write \"{src,test}/**/*.ts\"",
        "format:check": "../node_modules/prettier/bin-prettier.js --check \"{src,test}/**/*.ts\"",
        "lint": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\"",
        "lint:fix": "../node_modules/eslint/bin/eslint.js \"{src,test}/**/*.ts\" --fix"
    },
    "type": "module",
    "version": "1.0.0"
}
