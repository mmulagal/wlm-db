{
    "env": {
        "es2021": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "extends": [
        "airbnb-base",
        "eslint:recommended",
        "plugin:import/typescript",
        "plugin:@typescript-eslint/recommended",
        "prettier"
    ],
    "plugins": ["@typescript-eslint"],
    "settings": {
        "import/parsers": {
            "@typescript-eslint/parser": [".ts", ".tsx"]
        },
        "import/resolver": {
            "node": {
                "extensions": [".js", ".jsx", ".ts", ".tsx"],
                "moduleDirectory": ["server/src", "server/node_modules", "ui/src", "ui/node_modules"]
            },
            "typescript": {
                "alwaysTryTypes": true,
                "project": ["server/tsconfig.json", "ui/tsconfig.json"]
            }
        }
    },
    "rules": {
        "indent": ["off", 4, { "SwitchCase": 1, "ignoredNodes": ["ConditionalExpression"] }],
        "linebreak-style": ["error", "unix"],
        "quotes": ["error", "single"],
        "semi": ["error", "always"],
        "no-console": "error",
        "@typescript-eslint/no-explicit-any": "warn",
        "no-unused-expressions": "error",
        "no-const-assign": "error",
        "no-duplicate-imports": "error",
        "no-func-assign": "error",
        "no-unreachable": "error",
        "prefer-destructuring": "error",
        "arrow-parens": ["error", "as-needed"],
        "prefer-const": ["error", { "destructuring": "all" }],
        "quote-props": ["error", "as-needed"],
        "curly": ["error", "all"],
        "no-plusplus": ["error", { "allowForLoopAfterthoughts": true }],
        "no-shadow": "off",
        "@typescript-eslint/no-shadow": "error",
        "consistent-return": "off",
        "no-param-reassign": "off",
        "no-await-in-loop": "error",
        "no-restricted-syntax": "off",
        "default-param-last": "off",
        "no-use-before-define": "off",
        "no-underscore-dangle": "off",
        "no-nested-ternary": "off",
        "no-trailing-spaces": "error",
        "no-prototype-builtins": "off",
        "import/group-exports": "error",
        "import/prefer-default-export": "warn",
        "import/no-duplicates": "error",
        "import/extensions": "off",
        "import/no-extraneous-dependencies": "off",
        "import/no-unresolved": [
            "error",
            {
                "commonjs": true,
                "amd": true
            }
        ]
    },
    "overrides": [
        {
            "files": ["ui/**/*.{js,jsx,ts,tsx}"],
            "env": {
                "browser": true,
                "node": true,
                "es2021": true
            },
            "parserOptions": {
                "ecmaFeatures": {
                    "jsx": true
                },
                "ecmaVersion": 2021,
                "sourceType": "module"
            },
            "extends": [
                "eslint:recommended",
                "plugin:react/recommended",
                "plugin:react-hooks/recommended",
                "plugin:@typescript-eslint/recommended",
                "plugin:jsx-a11y/recommended",
                "airbnb",
                "airbnb/hooks",
                "prettier"
            ],
            "plugins": ["react", "react-hooks", "@typescript-eslint", "jsx-a11y"],
            "settings": {
                "react": {
                    "version": "detect"
                }
            },
            "rules": {
                // Any UI-specific rules go here.
                "quotes": ["error", "single", { "avoidEscape": true }],
                "jsx-quotes": ["error", "prefer-double"],
                "@typescript-eslint/no-use-before-define": "error",
                "import/extensions": [
                    "error",
                    "ignorePackages",
                    {
                        "ts": "never",
                        "tsx": "never",
                        "js": "never",
                        "jsx": "never"
                    }
                ],
                "import/no-extraneous-dependencies": ["error", { "devDependencies": true }],
                "react/react-in-jsx-scope": "off",
                "react/prop-types": "off",
                "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
                "jsx-a11y/no-autofocus": "off",
                "react/jsx-filename-extension": "off",
                "react/function-component-definition": "off",
                "@typescript-eslint/no-explicit-any": "warn",
                "react/require-default-props": "off"
            }
        }
    ]
}
